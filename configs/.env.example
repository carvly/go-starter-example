# 复制为仓库根目录下的 .env（本地开发用 github.com/joho/godotenv 自动
# 加载），或者在 CI/生产环境里以真正的环境变量形式导出。
# 这里只放占位符——真实的密钥/密码不能提交进仓库。
#
# 标 [必需] 的字段不设置会导致 Load() 直接报错退出，不会静默用零值启动。

# ---- 通用 ----

# 只读，用于给日志/指标打环境标签，不做代码分支判断
APP_ENV=development
# debug/info/warn/error
LOG_LEVEL=info

# ---- HTTP（仅 cmd/api 使用）----

HTTP_ADDR=:8080
# cmd/worker 的内部健康检查 + /metrics 端口，不发布到宿主机
HTTP_INTERNAL_ADDR=:9090
# 后台 server（/admin/v1）的监听地址，为空不启动；建议只绑内网或 localhost。
# 配置了地址时 HTTP_ADMIN_ORIGIN 必填：后台前端的 origin，形如 https://admin.example.com。
HTTP_ADMIN_ADDR=
HTTP_ADMIN_ORIGIN=
HTTP_BODY_LIMIT_BYTES=2097152
HTTP_REQUEST_TIMEOUT=10s
# 生产环境必须显式打开（比如 31536000 = 1 年），本地用 HTTP 时保持 0
HTTP_HSTS_MAX_AGE=0
# 服务是否部署在受信任的反向代理/负载均衡后面——这个值不能凭感觉猜，
# 必须匹配真实部署拓扑
HTTP_TRUSTED_PROXY=false
HTTP_GLOBAL_RATE_LIMIT_PER_SECOND=20
# GET /openapi.yaml 和 /docs（Redoc）这组只读文档路由的开关，默认开——
# 生产环境不想对外暴露 API 文档的话改成 false
HTTP_API_DOCS_ENABLED=true

# [必需] 显式列出信任的前端域名，不用 "*"；docker-compose 本地联调用
# http://localhost:5173 这类前端开发端口，按实际情况改
CORS_ALLOW_ORIGINS=http://localhost:5173

# ---- 数据库（Postgres，[必需]）----

# api 与 worker 必须使用同一个 DSN
DB_DSN=postgres://app:app@localhost:5432/app?sslmode=disable
DB_MIN_CONNS=2
DB_MAX_CONNS=25
DB_MAX_CONN_LIFETIME=1h
DB_HEALTH_CHECK_PERIOD=1m

# ---- Redis（可选）：缓存 + 多实例共享的限流计数；不设置时缓存退回 Noop、限流按进程内存计数 ----

# REDIS_ADDR=localhost:6379
# REDIS_PASSWORD=

# ---- 鉴权（JWT/Argon2id）----

# [必需] 生产环境用随机生成的高熵字符串，比如 `openssl rand -base64 32`
JWT_SIGNING_KEY=changeme
# [必需] 当前签名密钥对应的 kid，密钥轮换时换一个新值
JWT_KEY_ID=default
# 密钥轮换期间保留旧密钥用于校验旧 token，格式 "kid1:secret1,kid2:secret2"；
# 平时留空
# JWT_ADDITIONAL_KEYS=

# Argon2id 参数（基础设施配置，所有哈希密码的模块共用）——这里的默认值（64MB 内存、1 次迭代、
# 2 路并行）需要按部署环境实际可用内存和登录 QPS 压测调整，不是抄了就不用管的最终值
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=1
ARGON2_PARALLELISM=2

# ---- 后台员工（staff 模块）----
STAFF_SESSION_IDLE_TIMEOUT=30m
STAFF_SESSION_MAX_AGE=12h
STAFF_TEMP_PASSWORD_TTL=24h
# 操作日志保留期，默认 180 天
STAFF_AUDIT_RETENTION=4320h

# ---- 前台用户登录（微信各入口 + 会话）----

# [必需] 对外 API 的 origin，浏览器 OAuth 流程的 redirect_uri 由它和固定路径拼出，
# 第三方平台侧配置的回调地址必须和它一致
USER_PUBLIC_BASE_URL=https://api.example.com
# Origin 在这个名单内的请求，refresh token 只进 httpOnly cookie（响应体不含）；
# 名单外（App、小程序）走响应体。只列 web 前端的 origin
USER_COOKIE_DELIVERY_ORIGINS=https://app.example.com
# 会话各项时长；刷新宽限期只为网络重试准备，客户端必须串行刷新
USER_SESSION_MAX_AGE=720h
USER_SESSION_IDLE_TIMEOUT=168h
USER_ACCESS_TOKEN_TTL=15m
USER_REFRESH_GRACE_PERIOD=10s
USER_REAUTH_WINDOW=10m
# [可选] 部署在已校验身份的网关后面时填网关透传用户 ID 的 header（如 X-User-ID），前台鉴权改为信任它；
# 前提：客户端无法绕过网关直连、网关会清掉客户端带来的同名 header。留空用会话中间件（默认）
USER_TRUSTED_IDENTITY_HEADER=

# [可选] 微信登录入口的应用凭据，按产品需要组合：每个入口 appid 和 secret 成对配置
# 才启用，都留空就不启用，只配一半启动失败。subject 用 unionid，前提是启用的应用都
# 绑定到同一个开放平台账号（上线前完成，见 docs/agents/auth.md 的"微信平台要点"）
WECHAT_WEB_APP_ID=
WECHAT_WEB_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_SECRET=
WECHAT_MINI_APP_ID=
WECHAT_MINI_SECRET=
WECHAT_APP_APP_ID=
WECHAT_APP_SECRET=
