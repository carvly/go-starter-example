{
  "name": "go-starter-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-dist.ts && vite build && tsc && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "check:unused": "knip",
    "gen:api": "node scripts/gen-api.ts",
    "gen:routes": "node scripts/gen-routes.ts",
    "ui:add": "node scripts/ui.ts add",
    "ui:update": "node scripts/ui.ts update",
    "ui:check": "node scripts/ui.ts check",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.108.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.77.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.48.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.10.0"
}
